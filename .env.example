# Site pack
# Defaults to ./site, then ./site.example when ./site is missing.
# FAVORITE_PLACES_SITE_DIR=site.example

# bun run dev derives PORT and WORKTREE_DEV_PORT from the git worktree path.
WORKTREE_DEV_BASE_PORT=4321
WORKTREE_DEV_PORT_SPAN=1000

# Browser map rendering
GOOGLE_MAPS_JS_API_KEY=
PUBLIC_MAP_PROVIDER=

# Optional place chat on Cloudflare Pages. Enable both build-time and runtime flags.
PUBLIC_CHAT_ENABLED=false
CHAT_ENABLED=false
# CHAT_PROVIDER=cloudflare
# CHAT_MODEL=@cf/zai-org/glm-4.7-flash
# For another OpenAI-compatible provider, set CHAT_PROVIDER=openai-compatible,
# CHAT_MODEL, CHAT_API_BASE_URL (ending in /v1), and CHAT_API_KEY as a Pages secret.

# Google Maps and Places data refresh
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENRICHMENT_STRATEGY=scrape_then_api
# Optional typed overrides. Leave commented to use site/enrichment.json defaults.
# GOOGLE_MAPS_PLACES_LLM_REPAIR=dom
# GOOGLE_MAPS_PLACES_COLLECT_REVIEWS=false
# GOOGLE_MAPS_PLACES_COLLECT_ABOUT=false
GMAPS_SCRAPER_PROXY=
FAVORITE_PLACES_GMAPS_SCRAPER_STATE_DIR=

# LLM semantic enrichment and evals
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional Pages Function chat prototype. Enable both switches when deploying.
PUBLIC_CHAT_ENABLED=false
CHAT_ENABLED=false
# CHAT_PROVIDER=cloudflare
# CHAT_MODEL=@cf/zai-org/glm-4.7-flash
# For a separately budgeted OpenAI-compatible provider:
# CHAT_PROVIDER=openai-compatible
# CHAT_MODEL=
# CHAT_API_BASE_URL=
# CHAT_API_KEY=

# Optional Langfuse tracing for uncached LLM calls
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT=2
LANGFUSE_FLUSH_AT=8
LANGFUSE_FLUSH_INTERVAL=1.0
GMAPS_SCRAPER_LANGFUSE_FULL_CAPTURE=false
