---

import AuthorByline from "../../components/AuthorByline.astro";
import GuideMap from "../../components/GuideMap.astro";
import Layout from "../../components/Layout.astro";
import PlaceCard from "../../components/PlaceCard.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { siteConfig } from "../../data/site";
import { getDisplayCountryName, getGuides } from "../../lib/data";
import { getGuideAsideHtml, getTemplateHtml } from "../../lib/heroAsideContent";
import {
  getDisplayGuideTags,
  getDisplayPlaceTags,
  getGuideAreaFilterGroups,
  normalizeTagValue,
} from "../../lib/placeTags";
import { renderRichText } from "../../lib/renderRichText";
import { buildGuideJsonLd, buildGuideMetaDescription, buildWebsiteJsonLd } from "../../lib/seo";
import type { Place } from "../../lib/types";

const DEFAULT_SUGGESTION_PRIORITY = [
  "cozy",
  "date-night",
  "scenic",
  "rainy-day",
  "lively",
  "coffee",
  "breakfast",
  "favorite",
  "fine-dining",
  "fashion",
  "shopping",
  "dessert",
  "cocktails",
  "wine",
  "bakery",
];

const TYPE_SUGGESTION_PRIORITY: Record<string, string[]> = {
  cafe: ["coffee", "breakfast", "quiet", "dessert", "bakery", "pastries"],
  restaurant: ["date-night", "favorite", "fine-dining", "omakase", "ramen", "wine"],
  boutique: ["fashion", "shopping", "design", "vintage", "boutique"],
  bar: ["cocktails", "wine", "nightcap", "lively", "speakeasy"],
  bakery: ["coffee", "breakfast", "pastries", "dessert", "takeaway"],
  "tourist-attraction": ["scenic", "rainy-day", "iconic", "museum", "viewpoint"],
};
const BUDGET_KIND_DISPLAY = {
  restaurant_per_person: {
    label: "Food",
    title: "Restaurant spend per person",
    hint: "",
  },
  hotel_per_night: {
    label: "Stay / night",
    title: "Hotel nightly rate",
    hint: "",
  },
  admission_per_person: {
    label: "Entry",
    title: "Admission per person",
    hint: "",
  },
} as const;
const BUDGET_KIND_ORDER = [
  "restaurant_per_person",
  "hotel_per_night",
  "admission_per_person",
] as const;
const BUDGET_TIER_ORDER = [1, 2, 3, 4] as const;
const RATING_FILTER_THRESHOLDS = [4.5, 4.7, 4.8] as const;
const REVIEW_FILTER_THRESHOLDS = [100, 200, 500, 1000] as const;

function isSuggestibleTag(tag: string, citySlug: string, countrySlug: string): boolean {
  return Boolean(
    tag &&
      tag !== citySlug &&
      tag !== countrySlug &&
      !tag.endsWith("-city") &&
      !tag.endsWith("-county") &&
      !tag.endsWith("-prefecture") &&
      !tag.endsWith("-ward") &&
      !tag.endsWith("-township"),
  );
}

function buildSuggestionList(
  preferredTags: string[],
  fallbackTags: string[],
  limit: number,
  blockedTags: Set<string> = new Set(),
): string[] {
  const suggestions: string[] = [];
  const seen = new Set<string>();
  const availableTags = new Set(fallbackTags);

  for (const tag of [...preferredTags, ...fallbackTags]) {
    if (!tag || blockedTags.has(tag) || seen.has(tag) || !availableTags.has(tag)) {
      continue;
    }

    seen.add(tag);
    suggestions.push(tag);

    if (suggestions.length >= limit) {
      break;
    }
  }

  return suggestions;
}

function getPlaceFilterTags(
  place: Place,
  guideContext: { cityName?: string | null; countryCode?: string | null; countryName?: string | null },
): string[] {
  return [
    ...getDisplayGuideTags(getDisplayPlaceTags(place.tags ?? []), guideContext),
    ...getDisplayPlaceTags(place.vibe_tags ?? []),
  ];
}

export function getStaticPaths() {
  return getGuides().map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

const visiblePlaces = guide.places.filter(
  (place) => !place.hidden && place.status !== "closed-permanently",
);
const placeTagGuideContext = {
  cityName: guide.city_name,
  countryCode: guide.country_code,
  countryName: guide.country_name,
};
const featuredPlaceIds = new Set(guide.featured_place_ids ?? []);
const bestHitPlaceIds = new Set(guide.best_hit_place_ids ?? []);
const areaFilterGroups = getGuideAreaFilterGroups(visiblePlaces);
const areaFilters = areaFilterGroups.primary;
const broaderAreaFilters = areaFilterGroups.secondary;
const displayGuideTags = getDisplayGuideTags(guide.list_tags, placeTagGuideContext);
const displayCountryName = getDisplayCountryName(guide);
const guideAuthorName = guide.author?.name?.trim() || null;
const explicitTypes = [
  ...visiblePlaces.reduce((typeCounts, place) => {
    if (place.primary_category) {
      typeCounts.set(place.primary_category, (typeCounts.get(place.primary_category) ?? 0) + 1);
    }
    return typeCounts;
  }, new Map<string, number>()),
]
  .sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0]))
  .map(([type]) => type);
const visibleTypeSet = new Set(explicitTypes);
const browseTypes = [...new Set([...guide.top_categories.filter((type) => visibleTypeSet.has(type)), ...explicitTypes])];
const tagCounts = visiblePlaces.reduce((counts, place) => {
  [...new Set(getPlaceFilterTags(place, placeTagGuideContext))].forEach((tag) => {
    const normalizedTag = normalizeTagValue(tag);
    if (normalizedTag) {
      counts.set(normalizedTag, (counts.get(normalizedTag) ?? 0) + 1);
    }
  });
  return counts;
}, new Map<string, number>());
const allTags = [...tagCounts.keys()].sort((left, right) => left.localeCompare(right));
const citySlug = normalizeTagValue(guide.city_name);
const countrySlug = normalizeTagValue(guide.country_name);
const tagFallbacks = [...tagCounts.entries()]
  .map(([tag, count]) => ({ tag, count }))
  .filter(({ tag }) => isSuggestibleTag(tag, citySlug, countrySlug))
  .sort((left, right) => right.count - left.count || left.tag.localeCompare(right.tag))
  .map(({ tag }) => tag);
const defaultSuggestions = buildSuggestionList(DEFAULT_SUGGESTION_PRIORITY, tagFallbacks, 4);
const typeSeedTags = Object.fromEntries(
  browseTypes.map((type) => {
    const typeKey = normalizeTagValue(type);
    return [
      typeKey,
      [...new Set([typeKey, ...((TYPE_SUGGESTION_PRIORITY[typeKey] ?? []).map((tag) => normalizeTagValue(tag)))])],
    ];
  }),
);
const placeBrowseData = visiblePlaces.map((place) => ({
  filterTagSet: new Set(
    getPlaceFilterTags(place, placeTagGuideContext)
      .map((tag) => normalizeTagValue(tag))
      .filter(Boolean),
  ),
  normalizedCategory: normalizeTagValue(place.primary_category ?? ""),
}));
const typeCountsAccumulator = Object.fromEntries(
  browseTypes.map((type) => [normalizeTagValue(type), 0]),
) as Record<string, number>;
const typeKeysBySeed = new Map<string, string[]>();

for (const [typeKey, seeds] of Object.entries(typeSeedTags)) {
  for (const seed of seeds) {
    const matchingTypeKeys = typeKeysBySeed.get(seed) ?? [];
    matchingTypeKeys.push(typeKey);
    typeKeysBySeed.set(seed, matchingTypeKeys);
  }
}

for (const placeData of placeBrowseData) {
  const matchingTypeKeys = new Set<string>();

  if (placeData.normalizedCategory && placeData.normalizedCategory in typeCountsAccumulator) {
    matchingTypeKeys.add(placeData.normalizedCategory);
  }

  for (const seed of placeData.filterTagSet) {
    const seededTypeKeys = typeKeysBySeed.get(seed);
    if (!seededTypeKeys) {
      continue;
    }

    for (const typeKey of seededTypeKeys) {
      matchingTypeKeys.add(typeKey);
    }
  }

  for (const typeKey of matchingTypeKeys) {
    typeCountsAccumulator[typeKey] += 1;
  }
}

const typeCounts = typeCountsAccumulator;
const budgetCounts = visiblePlaces.reduce((counts, place) => {
  if (place.budget_kind && typeof place.budget_tier === "number") {
    const key = `${place.budget_kind}:${place.budget_tier}`;
    counts.set(key, (counts.get(key) ?? 0) + 1);
  }
  return counts;
}, new Map<string, number>());
const budgetRows = BUDGET_KIND_ORDER.map((kind) => {
  const tiers = BUDGET_TIER_ORDER.map((tier) => ({
    tier,
    count: budgetCounts.get(`${kind}:${tier}`) ?? 0,
    title: `${BUDGET_KIND_DISPLAY[kind].title} ${"$".repeat(tier)}`,
  }));
  const availableTiers = tiers.filter((tier) => tier.count > 0);
  return {
    kind,
    label: BUDGET_KIND_DISPLAY[kind].label,
    hint: BUDGET_KIND_DISPLAY[kind].hint,
    title: BUDGET_KIND_DISPLAY[kind].title,
    tiers,
    availableTierCount: availableTiers.length,
  };
}).filter((row) => row.availableTierCount > 1);
const ratingFilterOptions = RATING_FILTER_THRESHOLDS.map((threshold) => ({
  value: threshold,
  label: `${threshold.toFixed(1)}+`,
  count: visiblePlaces.filter((place) => typeof place.rating === "number" && place.rating >= threshold).length,
})).filter((option) => option.count > 0 && option.count < visiblePlaces.length);
const reviewFilterOptions = REVIEW_FILTER_THRESHOLDS.map((threshold) => ({
  value: threshold,
  label: `${threshold}+`,
  count: visiblePlaces.filter((place) => typeof place.user_rating_count === "number" && place.user_rating_count >= threshold).length,
})).filter((option) => option.count > 0 && option.count < visiblePlaces.length);
const hasMetricFilters = budgetRows.length > 0 || ratingFilterOptions.length > 0 || reviewFilterOptions.length > 0;
const guideDescriptionHtml = renderRichText(guide.description);
const guideAsideHtml = getGuideAsideHtml(guide.slug);
const guideBeforePlacesHtml = getTemplateHtml(`guide-before-places/${guide.slug}.html`) ?? getTemplateHtml("guide-before-places/default.html");
const guideAfterPlacesHtml = getTemplateHtml(`guide-after-places/${guide.slug}.html`) ?? getTemplateHtml("guide-after-places/default.html");
const guideSidebarFallback = siteConfig.guide.sidebarContent
  .map((content) => renderRichText(content))
  .filter((content): content is string => Boolean(content));
const hasMappablePlaces = visiblePlaces.some((place) => place.lat !== null && place.lng !== null);
const featuredPlaceNames = visiblePlaces
  .filter((place) => featuredPlaceIds.has(place.id))
  .map((place) => place.name)
  .slice(0, 3);
const guideMetaDescription = buildGuideMetaDescription({
  guide,
  countryName: displayCountryName,
  featuredPlaceNames,
});
const siteUrl = new URL("/", Astro.site ?? Astro.url).toString();
const pageUrl = new URL(`/guides/${guide.slug}/`, Astro.site ?? Astro.url).toString();
const guideJsonLd = [
  buildWebsiteJsonLd(siteUrl),
  ...buildGuideJsonLd({
    siteUrl,
    pageUrl,
    description: guideMetaDescription,
    guide,
    countryName: displayCountryName,
    visiblePlaces,
  }),
];
---

<Layout
  title={`${guide.title} · ${siteConfig.siteName}`}
  description={guideMetaDescription}
  canonicalPath={`/guides/${guide.slug}/`}
  openGraphType="article"
  jsonLd={guideJsonLd}
>
  <section class="hero ui-hero">
    <div class="hero-grid ui-hero-grid">
      <div class="section-stack ui-stack">
        <a class="utility-link ui-back-link" href="/">← {siteConfig.guide.backLinkLabel}</a>
        <p class="eyebrow ui-eyebrow">{guide.country_name}</p>
        <h1 class="ui-display">{guide.title}</h1>
        {
          guideDescriptionHtml ? (
            <p class="lede ui-lede rich-copy" set:html={guideDescriptionHtml} />
          ) : (
            <p class="lede ui-lede">{siteConfig.guide.fallbackDescription}</p>
          )
        }
        {siteConfig.guide.showAuthor && guide.author && guideAuthorName && <AuthorByline author={guide.author} label={siteConfig.guide.authorLabel} variant="hero" />}
        <div class="hero-meta ui-meta-row">
          <span class="stat-pill ui-pill">{guide.place_count} places</span>
          {guide.source_url && (
            <a class="action-pill ui-pill ui-pill--brand" href={guide.source_url} target="_blank" rel="noopener noreferrer">
              {siteConfig.guide.sourceListLabel}
            </a>
          )}
        </div>
      </div>

      {(guideAsideHtml ||
        guideSidebarFallback.length > 0 ||
        (siteConfig.guide.showGuideTags && displayGuideTags.length > 0)) && (
        <div class="section-stack ui-stack">
          {guideAsideHtml ? (
            <div class="small-copy ui-copy ui-copy--sm rich-copy" set:html={guideAsideHtml} />
          ) : (
            guideSidebarFallback.map((content) => (
              <p class="small-copy ui-copy ui-copy--sm rich-copy" set:html={content} />
            ))
          )}

          {siteConfig.guide.showGuideTags && displayGuideTags.length > 0 && (
            <>
              <p class="eyebrow ui-eyebrow">{siteConfig.guide.listTagsHeading}</p>
              <div class="tag-row ui-tag-row">
                {displayGuideTags.map((tag) => (
                  <span class="tag-pill ui-tag-pill">#{tag}</span>
                ))}
              </div>
            </>
          )}
        </div>
      )}
    </div>
  </section>

  {guideBeforePlacesHtml && <div class="template-block rich-copy" set:html={guideBeforePlacesHtml} />}

  <section
    class="section ui-section browse-section"
    data-guide-root
    data-guide-slug={guide.slug}
    data-all-tags={JSON.stringify(allTags)}
    data-default-suggestions={JSON.stringify(defaultSuggestions)}
    data-type-seeds={JSON.stringify(typeSeedTags)}
    data-has-mappable-places={hasMappablePlaces ? "true" : "false"}
    data-location-sort-fallback-text={siteConfig.guide.locationSortFallbackText}
  >
    <SectionHeading eyebrow={siteConfig.guide.browseEyebrow} title={siteConfig.guide.placesHeading} />

    <div class="browse-layout" data-browse-layout>
      <div class="browse-main" data-browse-main>
        <div class="controls-panel ui-control-panel">
          <div class="controls-grid" data-guide-controls>
            <div class="control-group control-group-search" style="grid-column: 1 / -1;">
              <div class="control-head">
                <label class="control-label ui-control-label" for="guide-search">{siteConfig.guide.searchLabel}</label>
                <span class="small-copy ui-copy ui-copy--sm search-hint">{siteConfig.guide.searchHint}</span>
              </div>
              <div class="search-shell">
                <input
                  class="ui-input"
                  id="guide-search"
                  name="guide-search"
                  type="search"
                  placeholder={siteConfig.guide.searchPlaceholder}
                  data-search-input
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                />
                <div class="tag-autocomplete" data-tag-autocomplete hidden></div>
              </div>
              <div class="selected-tag-row" data-selected-tags hidden></div>
            </div>

            {areaFilters.length > 0 && (
              <div class="control-group" style="grid-column: 1 / -1;">
                <span class="control-label ui-control-label">{siteConfig.guide.areaLabel}</span>
                <div class="tag-row ui-tag-row tag-row-mobile-scroll tag-row-mobile-grid-scroll">
                  <button class="tag-pill ui-tag-pill" type="button" data-area-filter data-area="" data-area-label="All areas">
                    <span>{siteConfig.guide.allFilterLabel}</span>
                    <span class="tag-pill-count" data-filter-count>{visiblePlaces.length}</span>
                  </button>
                  {areaFilters.map((area) => (
                    <button
                      class="tag-pill ui-tag-pill"
                      type="button"
                      data-area-filter
                      data-area={area.value}
                      data-area-label={area.label}
                    >
                      <span>{area.label}</span>
                      <span class="tag-pill-count" data-filter-count>{area.count}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {broaderAreaFilters.length > 0 && (
              <div class="control-group" style="grid-column: 1 / -1;">
                <span class="control-label ui-control-label">{siteConfig.guide.broaderAreaLabel}</span>
                <div class="tag-row ui-tag-row tag-row-mobile-scroll tag-row-mobile-grid-scroll">
                  {broaderAreaFilters.map((area) => (
                    <button
                      class="tag-pill ui-tag-pill"
                      type="button"
                      data-area-filter
                      data-area={area.value}
                      data-area-label={area.label}
                    >
                      <span>{area.label}</span>
                      <span class="tag-pill-count" data-filter-count>{area.count}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {browseTypes.length > 0 && (
              <div class="control-group" style="grid-column: 1 / -1;">
                <span class="control-label ui-control-label">{siteConfig.guide.typeLabel}</span>
                <div class="tag-row ui-tag-row tag-row-mobile-scroll tag-row-mobile-grid-scroll">
                  <button class="tag-pill ui-tag-pill" type="button" data-type-filter data-type="">
                    <span>{siteConfig.guide.allFilterLabel}</span>
                    <span class="tag-pill-count" data-filter-count>{visiblePlaces.length}</span>
                  </button>
                  {browseTypes.map((type) => (
                    <button class="tag-pill ui-tag-pill" type="button" data-type-filter data-type={normalizeTagValue(type)}>
                      <span>{type}</span>
                      <span class="tag-pill-count" data-filter-count>{typeCounts[normalizeTagValue(type)] ?? 0}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {hasMetricFilters && (
              <div class="control-group control-group-compact metric-filter-group" style="grid-column: 1 / -1;">
                <div class="metric-filter-row">
                  {budgetRows.length > 0 && (
                    <details class="price-filter-menu metric-filter-price">
                      <summary class="price-filter-trigger">
                        <span class="price-filter-title">Price</span>
                        <span class="price-filter-summary" data-budget-summary>Any</span>
                      </summary>
                      <div class="price-filter-panel">
                        {budgetRows.map((row) => (
                          <div class="price-filter-row">
                            <div class="price-filter-row-head">
                              <span class="price-filter-row-label">{row.label}</span>
                              {row.hint && <span class="price-filter-row-hint">{row.hint}</span>}
                            </div>
                            <fieldset class="price-filter-options" aria-label={row.title}>
                              <button
                                class="price-filter-option price-filter-option-any"
                                type="button"
                                data-budget-clear-kind={row.kind}
                              >
                                Any
                              </button>
                              {row.tiers.map((filter) => (
                                <button
                                  class="price-filter-option"
                                  type="button"
                                  data-budget-filter
                                  data-budget-kind={row.kind}
                                  data-budget-kind-label={row.label}
                                  data-budget-tier={String(filter.tier)}
                                  title={filter.title}
                                  aria-label={filter.title}
                                  aria-pressed="false"
                                  disabled={filter.count === 0}
                                >
                                  <span aria-hidden="true">{"$".repeat(filter.tier)}</span>
                                  <span class="price-filter-count" data-filter-count>{filter.count}</span>
                                </button>
                              ))}
                            </fieldset>
                          </div>
                        ))}
                      </div>
                    </details>
                  )}

                  {ratingFilterOptions.length > 0 && (
                    <fieldset class="metric-filter-segment" aria-label="Minimum rating">
                      <span class="metric-filter-label" aria-hidden="true">★</span>
                      <button class="price-filter-option metric-filter-option" type="button" data-rating-filter data-rating-min="">
                        Any
                      </button>
                      {ratingFilterOptions.map((option) => (
                        <button
                          class="price-filter-option metric-filter-option"
                          type="button"
                          data-rating-filter
                          data-rating-min={String(option.value)}
                          aria-pressed="false"
                        >
                          <span>{option.label}</span>
                          <span class="price-filter-count" data-filter-count>{option.count}</span>
                        </button>
                      ))}
                    </fieldset>
                  )}

                  {reviewFilterOptions.length > 0 && (
                    <fieldset class="metric-filter-segment" aria-label="Minimum review count">
                      <span class="metric-filter-label">Reviews</span>
                      <button class="price-filter-option metric-filter-option" type="button" data-review-filter data-review-min="">
                        Any
                      </button>
                      {reviewFilterOptions.map((option) => (
                        <button
                          class="price-filter-option metric-filter-option"
                          type="button"
                          data-review-filter
                          data-review-min={String(option.value)}
                          aria-pressed="false"
                        >
                          <span>{option.label}</span>
                          <span class="price-filter-count" data-filter-count>{option.count}</span>
                        </button>
                      ))}
                    </fieldset>
                  )}
                </div>
              </div>
            )}

            {defaultSuggestions.length > 0 && (
              <div class="control-group" style="grid-column: 1 / -1;">
                <div class="control-head">
                  <span class="control-label ui-control-label">{siteConfig.guide.popularTagsLabel}</span>
                  <span class="small-copy ui-copy ui-copy--sm search-hint">{siteConfig.guide.popularTagsHint}</span>
                </div>
                <div class="tag-row ui-tag-row tag-row-mobile-scroll" data-suggestion-list>
                  {defaultSuggestions.map((tag) => (
                    <button class="tag-pill ui-tag-pill" type="button" data-suggestion-tag={tag}>
                      <span>#{tag}</span>
                      <span class="tag-pill-count" data-filter-count data-tag-count-text>{tagCounts.get(tag) ?? 0}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="results-row ui-results-row">
          <p class="small-copy ui-copy ui-copy--sm" data-results-count>{visiblePlaces.length} places</p>
          <div class="results-actions">
            <label class="results-sort" for="guide-sort">
              <span class="results-sort-label">{siteConfig.guide.resultsSortLabel}</span>
              <span class="results-sort-shell">
                <select class="ui-input" id="guide-sort" name="guide-sort" data-sort-select>
                  <option value="curated">{siteConfig.guide.sortCuratedLabel}</option>
                  {hasMappablePlaces && <option value="nearby">{siteConfig.guide.sortNearMeLabel}</option>}
                  <option value="rating">{siteConfig.guide.sortRatingLabel}</option>
                  <option value="name">{siteConfig.guide.sortNameLabel}</option>
                  <option value="neighborhood">{siteConfig.guide.sortNeighborhoodLabel}</option>
                </select>
                <span class="results-sort-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M4.2 6.1 8 9.9l3.8-3.8 1.1 1.1L8 12.1 3.1 7.2z"></path>
                  </svg>
                </span>
              </span>
            </label>
            <button class="map-filter-reset" type="button" data-map-filter-reset hidden>{siteConfig.guide.resetMapLabel}</button>
          </div>
        </div>
        <p class="map-filter-status small-copy ui-copy ui-copy--sm" data-area-filter-status hidden></p>
        <p class="map-filter-status small-copy ui-copy ui-copy--sm" data-location-sort-status hidden></p>
        <p class="map-filter-status small-copy ui-copy ui-copy--sm" data-map-filter-status hidden>{siteConfig.guide.mapFilteredText}</p>
        <div class="empty-state ui-empty-state" data-empty-state>{siteConfig.guide.emptyStateText}</div>

        <div class="card-grid ui-card-grid" data-kind="places" data-place-list>
          {visiblePlaces.map((place) => (
            <PlaceCard
              place={place}
              guideAuthor={guide.author}
              guideContext={placeTagGuideContext}
              guidePhotoMode={guide.place_photo_mode}
              featured={featuredPlaceIds.has(place.id)}
              bestHit={bestHitPlaceIds.has(place.id)}
            />
          ))}
        </div>
      </div>

      <GuideMap places={visiblePlaces} />
    </div>
  </section>

  {guideAfterPlacesHtml && <div class="template-block rich-copy" set:html={guideAfterPlacesHtml} />}

  <script is:inline type="module" src="/scripts/guide-filters.js"></script>
  <script is:inline type="module" src="/scripts/scroll-jump.js"></script>
</Layout>
