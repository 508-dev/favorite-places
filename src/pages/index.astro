---

import { slugifyCountry } from "../../public/scripts/home-browser-state.js";
import GuideCard from "../components/GuideCard.astro";
import HomeGuideMap from "../components/HomeGuideMap.astro";
import Layout from "../components/Layout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import "../styles/home.css";
import { siteConfig } from "../data/site";
import { getGuideManifests } from "../lib/data";
import { getHomeAsideHtml, getTemplateHtml } from "../lib/heroAsideContent";
import { renderRichText } from "../lib/renderRichText";
import { buildHomeJsonLd, buildHomeMetaDescription, buildWebsiteJsonLd } from "../lib/seo";

const guides = getGuideManifests();
const countryEntries = Object.entries(
  guides.reduce<Record<string, typeof guides>>((accumulator, guide) => {
    const key = guide.country_name || "Unknown";
    accumulator[key] ??= [];
    accumulator[key].push(guide);
    return accumulator;
  }, {}),
).sort(([left], [right]) => left.localeCompare(right));
const flagPattern = /[\u{1F1E6}-\u{1F1FF}]{2}/gu;
const countryCodeToFlag = (countryCode: string | null) =>
  countryCode && /^[a-z]{2}$/i.test(countryCode)
    ? countryCode
        .toUpperCase()
        .replace(/./g, (character) => String.fromCodePoint(127397 + character.charCodeAt(0)))
    : "";
const getCountryFlag = (countryGuides: typeof guides) => {
  const flagCounts = countryGuides.reduce<Record<string, number>>((accumulator, guide) => {
    const flags = [...guide.title.matchAll(flagPattern)].map(([flag]) => flag);
    const flag = flags.at(-1) || countryCodeToFlag(guide.country_code);

    if (flag) {
      accumulator[flag] = (accumulator[flag] ?? 0) + 1;
    }

    return accumulator;
  }, {});

  return Object.entries(flagCounts).sort(([, leftCount], [, rightCount]) => rightCount - leftCount)[0]?.[0] ?? "";
};
const guidesByCountry = countryEntries.map(([countryName, countryGuides]) => ({
  countryGuides,
  countryName,
  countryFlag: getCountryFlag(countryGuides),
}));
const featuredCountryExclusions = new Set(siteConfig.home.featuredCountryExclusions.map(slugifyCountry));
const defaultPostcards = ["travel-notebook", "railway-window", "corner-cafe"];
const featuredCountries = guidesByCountry
  .filter(({ countryName }) => countryName !== "Unknown" && !featuredCountryExclusions.has(slugifyCountry(countryName)))
  .sort((left, right) => right.countryGuides.length - left.countryGuides.length)
  .slice(0, 3);
const cityMarkerEmoji: Record<string, string> = {
  amsterdam: "🚲",
  bangkok: "🛺",
  barcelona: "🏖️",
  belfast: "🛳️",
  berlin: "🪩",
  "cape-town": "⛰️",
  chicago: "🌆",
  copenhagen: "🚲",
  dubai: "🏙️",
  florence: "🎨",
  fukuoka: "🍜",
  hakodate: "🌃",
  hanoi: "🛵",
  "hong-kong": "🌃",
  ibiza: "🎧",
  ishigaki: "🌺",
  kanazawa: "🍵",
  karuizawa: "🌲",
  kyoto: "⛩️",
  "las-vegas": "🎰",
  london: "🎡",
  "los-angeles": "🎬",
  madrid: "💃",
  melbourne: "☕",
  "mexico-city": "🌮",
  monaco: "🏎️",
  nagasaki: "⛪",
  nagoya: "🏯",
  "new-york": "🗽",
  oahu: "🏄",
  oaxaca: "🌮",
  paris: "🥐",
  sapporo: "🍺",
  "san-francisco": "🌉",
  seoul: "🎧",
  singapore: "🦁",
  sydney: "🎭",
  taipei: "🥟",
  takayama: "🏯",
  tokyo: "🗼",
  venice: "🛶",
  vienna: "🎼",
  yufuin: "♨️",
  zurich: "🏔️",
};
const normalizeCityMarkerKey = (cityName: string) =>
  cityName
    .toLowerCase()
    .replace(/&/g, " and ")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
const cityInitials = (cityName: string) =>
  cityName
    .split(/[\s-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("") || cityName.slice(0, 2).toUpperCase();
const guideMarkerLabel = (guide: (typeof guides)[number]) => {
  const titleFlags = [...guide.title.matchAll(flagPattern)].map(([flag]) => flag);
  const cityEmoji = cityMarkerEmoji[normalizeCityMarkerKey(guide.city_name)];
  return cityEmoji || titleFlags.at(-1) || countryCodeToFlag(guide.country_code) || cityInitials(guide.city_name);
};
const locationGuideCandidates = guides
  .filter((guide) => typeof guide.center_lat === "number" && typeof guide.center_lng === "number")
  .map((guide) => {
    const countryName = guide.country_name || "Unknown";

    return {
      cityName: guide.city_name || "",
      countryCode: guide.country_code,
      slug: guide.slug,
      title: guide.title,
      country: countryName.toLowerCase(),
      countryName,
      lat: guide.center_lat as number,
      lng: guide.center_lng as number,
      markerLabel: guideMarkerLabel(guide),
      placeCount: guide.place_count,
      url: `/guides/${guide.slug}/`,
    };
  });
const countryCount = guidesByCountry.length;
const placeCount = guides.reduce((count, guide) => count + guide.place_count, 0);
const homeAsideHtml = getHomeAsideHtml();
const homeHighlights = siteConfig.home.highlights
  .map((highlight) => renderRichText(highlight))
  .filter((highlight): highlight is string => Boolean(highlight));
const homeBeforeGuidesHtml = getTemplateHtml("home-before-guides.html");
const homeAfterGuidesHtml = getTemplateHtml("home-after-guides.html");
const siteUrl = new URL("/", Astro.site ?? Astro.url).toString();
const homeMetaDescription = buildHomeMetaDescription({
  intro: siteConfig.home.intro,
  guideCount: guides.length,
  countryCount,
  placeCount,
});
const homeJsonLd = [
  buildWebsiteJsonLd(siteUrl),
  buildHomeJsonLd({
    siteUrl,
    pageUrl: siteUrl,
    description: homeMetaDescription,
    guides,
  }),
];
---

<Layout
  title={siteConfig.siteName}
  description={homeMetaDescription}
  canonicalPath="/"
  openGraphType="website"
  jsonLd={homeJsonLd}
>
  {siteConfig.home.showHero && (
    <section class="home-welcome">
      {siteConfig.home.eyebrow && <p class="ui-eyebrow">{siteConfig.home.eyebrow}</p>}
      <h1 class="ui-display">{siteConfig.home.title}</h1>
      <p class="ui-lede">{siteConfig.home.intro}</p>
      <div class="home-welcome-actions">
        {siteConfig.home.showGuideBrowser && guides.length > 0 && (
          <a class="home-browse-link" href="#browse-guides" data-home-browse-link>Browse all guides <span aria-hidden="true">↓</span></a>
        )}
        {siteConfig.home.showHeroStats && (
          <p class="ui-copy ui-copy--sm">
            {guides.length.toLocaleString("en")} {guides.length === 1 ? "guide" : "guides"} · {countryCount.toLocaleString("en")} {countryCount === 1 ? "country" : "countries"} · {placeCount.toLocaleString("en")} saved {placeCount === 1 ? "place" : "places"}
          </p>
        )}
      </div>
    </section>
  )}

  {homeBeforeGuidesHtml && <div class="template-block rich-copy" set:html={homeBeforeGuidesHtml} />}

  {siteConfig.home.showGuideBrowser && (
    <section
      class="section ui-section home-browser"
      data-home-browser-root
      data-country-sections-visible={siteConfig.home.showCountrySections ? "true" : "false"}
    >
      {featuredCountries.length > 0 && siteConfig.home.showGuideBrowserControls && (
        <section class="home-featured" aria-labelledby="featured-destinations">
          <h2 class="ui-section-title" id="featured-destinations">Featured destinations</h2>
          <ul class="home-postcards">
            {featuredCountries.map(({ countryName, countryGuides }, index) => {
              const countrySlug = slugifyCountry(countryName);
              const artwork = siteConfig.home.featuredCountryImages[countrySlug] || `/images/country-postcards/${defaultPostcards[index]}.webp`;

              return (
                <li>
                  <a class="home-postcard" href={`#${countrySlug}`} data-featured-country={countryName.toLowerCase()}>
                    <img src={artwork} alt="" width="768" height="384" decoding="async" />
                    <span class="home-postcard-caption">
                      <strong>{countryName}</strong>
                      <span>{countryGuides.length} {countryGuides.length === 1 ? "guide" : "guides"}</span>
                      <span class="home-postcard-arrow" aria-hidden="true">→</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <div id="browse-guides" data-home-browse-heading tabindex="-1">
        {siteConfig.home.guidesEyebrow && <p class="ui-eyebrow">{siteConfig.home.guidesEyebrow}</p>}
        <h2 class="ui-section-title">{siteConfig.home.guidesHeading}</h2>
      </div>

      {siteConfig.home.showGuideBrowserControls && (
        <div class="controls-panel ui-control-panel country-browser home-controls" data-home-browser-controls>
          <div class="home-control-row">
            <div class="control-group">
              <label class="control-label ui-control-label" for="guide-search">{siteConfig.home.searchLabel}</label>
              <input
                class="ui-input"
                id="guide-search"
                name="guide-search"
                type="search"
                placeholder={siteConfig.home.searchPlaceholder}
                data-home-search-input
              />
            </div>

            <div class="control-group">
              <label class="control-label ui-control-label" for="guide-country">{siteConfig.home.countriesLabel}</label>
              <select class="ui-input" id="guide-country" data-country-select>
                <option value="">{siteConfig.home.allCountriesLabel}</option>
                {guidesByCountry.map(({ countryName, countryGuides, countryFlag }) => (
                  <option value={countryName.toLowerCase()} data-label={countryName} data-flag={countryFlag}>
                    {countryFlag ? `${countryName} ${countryFlag}` : countryName} ({countryGuides.length})
                  </option>
                ))}
              </select>
            </div>

            {siteConfig.home.showMap && locationGuideCandidates.length > 0 && (
              <button class="location-target-button home-nearby" type="button" data-location-target>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                  <circle cx="12" cy="12" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                  <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
                  <path d="M12 2v3M12 19v3M2 12h3M19 12h3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
                {siteConfig.home.nearMeLabel}
              </button>
            )}
          </div>

          <div class="home-control-status">
            <p class="ui-copy ui-copy--sm" data-home-results-count role="status">
              {guides.length} guides across {countryCount} countries
            </p>
            {siteConfig.home.showMap && (
              <p class="location-status ui-copy ui-copy--sm" data-location-status role="status"></p>
            )}
          </div>
        </div>
      )}

      <div class="empty-state ui-empty-state" data-home-empty-state>
        {siteConfig.home.emptyStateText}
      </div>

      {siteConfig.home.showMap && <HomeGuideMap guides={locationGuideCandidates} />}

      <div
        class="global-search-results ui-search-results"
        data-global-search-results
        role="status"
        aria-live="polite"
        aria-atomic="true"
        aria-hidden="true"
        hidden
      >
        <div class="ui-section-head">
          <div class="ui-section-heading">
            <p class="ui-eyebrow">{siteConfig.home.searchResultsEyebrow}</p>
            <h3 class="ui-section-title" data-global-search-title>{siteConfig.home.searchResultsHeading}</h3>
          </div>
        </div>
        <div class="search-results-toolbar" data-global-search-toolbar>
          <div class="search-conversation" data-global-search-conversation hidden>
            <p class="small-copy ui-copy ui-copy--sm" data-global-search-summary></p>
            <div class="tag-row ui-tag-row" data-global-search-suggestions></div>
          </div>
          <fieldset class="search-view-toggle-group">
            <legend class="visually-hidden">Search results view</legend>
            <button
              class="search-view-toggle"
              type="button"
              data-search-view-toggle
              data-search-view="grouped"
              aria-pressed="true"
            >
              {siteConfig.home.searchResultsGroupedLabel}
            </button>
            <button
              class="search-view-toggle"
              type="button"
              data-search-view-toggle
              data-search-view="individual"
              aria-pressed="false"
            >
              {siteConfig.home.searchResultsIndividualLabel}
            </button>
          </fieldset>
        </div>
        <div class="search-country-grid" data-grouped-search-list></div>
        <div class="search-result-grid" data-global-search-list hidden></div>
        <div class="empty-state ui-empty-state" data-global-search-empty role="status" aria-live="polite">
          {siteConfig.home.searchResultsEmptyText}
        </div>
      </div>
      {guidesByCountry.map(({ countryName, countryGuides, countryFlag }) => (
        <div class="country-block ui-country-block" data-country-block data-country={countryName.toLowerCase()} id={slugifyCountry(countryName)}>
          <div class="ui-section-head country-section-head">
            <div class="country-title-row">
              <h3 class="ui-section-title">{countryFlag ? `${countryName} ${countryFlag}` : countryName}</h3>
              <span class="count-chip country-guide-count">
                <strong>{countryGuides.length}</strong>
                <span>guide{countryGuides.length === 1 ? "" : "s"}</span>
              </span>
            </div>
          </div>

          <div class="card-grid ui-card-grid">
            {countryGuides.map((guide) => (
              <GuideCard guide={guide} />
            ))}
          </div>
        </div>
      ))}

    </section>
  )}

  {import.meta.env.PUBLIC_CHAT_ENABLED === "true" && (
    <section class="section ui-section place-chat" data-place-chat>
      <SectionHeading eyebrow="Ask the guide" title="Find a place together" />
      <p class="small-copy ui-copy ui-copy--sm">Tell me what you are looking for, then refine the suggestions in a follow-up.</p>
      <div class="place-chat-thread" data-place-chat-thread role="log" aria-live="polite" aria-label="Place chat"></div>
      <form class="place-chat-form" data-place-chat-form>
        <label class="visually-hidden" for="place-chat-input">Ask for a place</label>
        <input class="ui-input" id="place-chat-input" name="message" type="text" maxlength="500" placeholder="A quiet café in Tokyo to linger in..." required data-place-chat-input />
        <button class="button place-chat-submit" type="submit" data-place-chat-submit>Ask</button>
      </form>
      <p class="small-copy ui-copy ui-copy--sm place-chat-status" data-place-chat-status role="status"></p>
    </section>
  )}

  {homeAfterGuidesHtml && <div class="template-block rich-copy" set:html={homeAfterGuidesHtml} />}

  {siteConfig.home.showHero && (homeAsideHtml || homeHighlights.length > 0 || siteConfig.home.guidesLinkText) && (
    <aside class="home-about" aria-label={siteConfig.home.highlightsHeading}>
      {siteConfig.home.highlightsHeading && <h2 class="ui-section-title">{siteConfig.home.highlightsHeading}</h2>}
      {homeAsideHtml ? (
        <div class="small-copy ui-copy ui-copy--sm rich-copy" set:html={homeAsideHtml} />
      ) : (
        homeHighlights.map((highlight) => (
          <p class="small-copy ui-copy ui-copy--sm rich-copy" set:html={highlight} />
        ))
      )}
      {siteConfig.home.guidesLinkText && siteConfig.navLinks[1] && (
        <p class="ui-copy ui-copy--sm"><a href={siteConfig.navLinks[1].href}>{siteConfig.home.guidesLinkText}</a></p>
      )}
    </aside>
  )}

  {import.meta.env.PUBLIC_CHAT_ENABLED === "true" && <script is:inline type="module" src="/scripts/place-chat.js"></script>}
  {siteConfig.home.showGuideBrowser && <script is:inline type="module" src="/scripts/home-browser.js"></script>}
  {siteConfig.home.showGuideBrowser && <script is:inline type="module" src="/scripts/scroll-jump.js"></script>}
</Layout>
