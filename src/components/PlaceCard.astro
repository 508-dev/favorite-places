---

import { siteConfig } from "../data/site";
import { getDisplayGuideTags, getDisplayPlaceTags, getTagComparisonValue } from "../lib/placeTags";
import { renderRichText } from "../lib/renderRichText";
import type { ListAuthor, Place, TrustSignal } from "../lib/types";
import AuthorByline from "./AuthorByline.astro";

interface Props {
  bestHit?: boolean;
  featured?: boolean;
  guideAuthor?: ListAuthor | null;
  guideContext?: {
    cityName?: string | null;
    countryCode?: string | null;
    countryName?: string | null;
  };
  guidePhotoMode?: "local_cache" | "remote_url";
  place: Place;
}

function authorsReferToSamePerson(left: ListAuthor | null | undefined, right: ListAuthor | null | undefined): boolean {
  if (!left || !right) {
    return false;
  }

  const leftProfileId = left.profile_id?.trim();
  const rightProfileId = right.profile_id?.trim();
  if (leftProfileId && rightProfileId) {
    return leftProfileId === rightProfileId;
  }

  const leftName = left.name?.trim();
  const rightName = right.name?.trim();
  if (!leftName || !rightName) {
    return false;
  }

  return leftName.toLowerCase() === rightName.toLowerCase();
}

function safeHttpUrl(value: string | null | undefined): string | null {
  if (!value) {
    return null;
  }
  try {
    const url = new URL(value);
    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null;
  } catch {
    return null;
  }
}

const {
  bestHit = false,
  featured = false,
  guideAuthor = null,
  guideContext = {},
  guidePhotoMode = "local_cache",
  place,
} = Astro.props;
const placeTags = place.tags ?? [];
const configuredVisibleTags = place.visible_tags ?? [];
const placeVibeTags = place.vibe_tags ?? [];
const displayTags = getDisplayGuideTags(getDisplayPlaceTags(placeTags), guideContext);
const visibleTags = (
  configuredVisibleTags.length > 0
    ? getDisplayGuideTags(getDisplayPlaceTags(configuredVisibleTags), guideContext)
    : displayTags
).slice(0, siteConfig.placeCard.maxTags);
const displayVibeTags = getDisplayPlaceTags(placeVibeTags);
const filterTagTokens = JSON.stringify(displayTags.map(getTagComparisonValue));
const filterVibeTagTokens = JSON.stringify(displayVibeTags.map(getTagComparisonValue));
const localityPathTokens = JSON.stringify((place.locality_path ?? []).map(getTagComparisonValue));
const neighborhoodToken = getTagComparisonValue(place.neighborhood ?? "");
const whyRecommendedHtml = renderRichText(place.why_recommended ?? place.note);
const placePhotosEnabled = (import.meta.env.PUBLIC_PLACE_PHOTOS || "on").toLowerCase() !== "off";
const photoSrc = place.main_photo_path ?? (guidePhotoMode === "remote_url" ? place.photo_url : null);
const hasPhoto = Boolean(siteConfig.placeCard.showPhoto && placePhotosEnabled && photoSrc);
const ratingValue = typeof place.rating === "number" ? place.rating : null;
const reviewCount = typeof place.user_rating_count === "number" ? place.user_rating_count : null;
const priceRange = typeof place.price_range === "string" && place.price_range.trim().length > 0 ? place.price_range.trim() : null;
const ratingFormatter = new Intl.NumberFormat("en-US", {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const compactReviewCountFormatter = new Intl.NumberFormat("en-US", {
  notation: "compact",
  maximumFractionDigits: 1,
});
const reviewCountFormatter = new Intl.NumberFormat("en-US");
const compactReviewLabel =
  reviewCount !== null
    ? `${compactReviewCountFormatter.format(reviewCount)} ${reviewCount === 1 ? "review" : "reviews"}`
    : null;
const placeRatingMetaLabel = [
  siteConfig.placeCard.showRating && ratingValue !== null ? `${ratingFormatter.format(ratingValue)} ★` : null,
  siteConfig.placeCard.showReviewCount ? compactReviewLabel : null,
  siteConfig.placeCard.showPriceRange ? priceRange : null,
]
  .filter(Boolean)
  .join(" · ");
const placeRatingMetaTitle = [
  siteConfig.placeCard.showRating && ratingValue !== null ? `${ratingFormatter.format(ratingValue)} Google Maps rating` : null,
  siteConfig.placeCard.showReviewCount && reviewCount !== null
    ? `${reviewCountFormatter.format(reviewCount)} Google Maps ${reviewCount === 1 ? "review" : "reviews"}`
    : null,
  siteConfig.placeCard.showPriceRange && priceRange !== null ? `Price range ${priceRange}` : null,
]
  .filter(Boolean)
  .join(" · ");
const rawTrustSignals = siteConfig.placeCard.showTrustSignals
  ? (place.trust_signals ?? []).filter((signal) => signal.confidence !== "low")
  : [];
const isSafeExternalUrl = (value: string | null | undefined): value is string => {
  if (!value) {
    return false;
  }
  try {
    const parsed = new URL(value);
    return parsed.protocol === "https:" || parsed.protocol === "http:";
  } catch {
    return false;
  }
};
type CardTrustSignal = TrustSignal & {
  url: string | null;
  groupedTrustSignalLabels?: string[];
  groupedTrustSignalConfidenceNotes?: string[];
};
const trustSignalBaseLabel = (signal: TrustSignal) =>
  [
    signal.source === "michelin" && signal.is_current === false
      ? "Previous MICHELIN Guide"
      : signal.display_label ?? signal.label,
    signal.display_tier ?? signal.tier,
    signal.award_year ? String(signal.award_year) : null,
  ].filter(Boolean).join(" · ");
const trustSignalAwardTierKey = (signal: TrustSignal) => signal.display_tier ?? signal.tier ?? "";
const currentAwardKeys = new Set(
  rawTrustSignals
    .filter((signal) => (signal.source === "michelin" || signal.source === "tabelog") && signal.is_current === true)
    .map((signal) => `${signal.source}:${trustSignalAwardTierKey(signal)}`),
);
const shouldHidePreviousTrustSignal = (signal: TrustSignal) =>
  signal.is_current === false && currentAwardKeys.has(`${signal.source}:${trustSignalAwardTierKey(signal)}`);
const trustSignalConfidenceNote = (signal: TrustSignal) => {
  if (signal.confidence !== "medium") {
    return null;
  }
  const normalizedReason = signal.match_reason.toLowerCase();
  if (normalizedReason.includes("alias") && normalizedReason.includes("location")) {
    return "Matched by alternate name and location";
  }
  if (normalizedReason.includes("similarity") && normalizedReason.includes("location")) {
    return "Matched by similar name and location";
  }
  if (normalizedReason.includes("similarity")) {
    return "Matched by similar name";
  }
  if (normalizedReason.includes("location")) {
    return "Matched by name and location";
  }
  return "Matched with medium confidence";
};
const combineTabelogTrustSignals = (signals: CardTrustSignal[]) => {
  const tabelogSignals = signals.filter((signal) => signal.source === "tabelog");
  if (tabelogSignals.length <= 1) {
    return signals;
  }

  const firstTabelogIndex = signals.findIndex((signal) => signal.source === "tabelog");
  const nonTabelogSignals = signals.filter((signal) => signal.source !== "tabelog");
  const combinedTabelogSignal = {
    ...tabelogSignals[0],
    groupedTrustSignalLabels: tabelogSignals.map(trustSignalBaseLabel),
    groupedTrustSignalConfidenceNotes: Array.from(
      new Set(tabelogSignals.map(trustSignalConfidenceNote).filter(Boolean)),
    ),
  };

  return [
    ...nonTabelogSignals.slice(0, firstTabelogIndex),
    combinedTabelogSignal,
    ...nonTabelogSignals.slice(firstTabelogIndex),
  ];
};
const trustSignals = combineTabelogTrustSignals(rawTrustSignals
  .filter((signal) => !shouldHidePreviousTrustSignal(signal))
  .map((signal) => ({
    ...signal,
    url: isSafeExternalUrl(signal.url) ? signal.url : null,
  })))
  .slice(0, 3);
const trustSignalLabel = (signal: (typeof trustSignals)[number]) =>
  signal.groupedTrustSignalLabels?.join(" + ") ?? trustSignalBaseLabel(signal);
const trustSignalTitle = (signal: (typeof trustSignals)[number]) =>
  [
    trustSignalLabel(signal),
    ...(signal.groupedTrustSignalConfidenceNotes ?? [trustSignalConfidenceNote(signal)]),
  ].filter(Boolean).join(" · ");
const trustSignalClassName = (signal: (typeof trustSignals)[number]) =>
  [
    "stat-pill ui-pill place-card-trust-pill",
    signal.source === "michelin" ? "place-card-trust-pill--michelin" : null,
    signal.source === "michelin" ? michelinTrustSignalModifier(signal.tier) : null,
    signal.is_current === false ? "place-card-trust-pill--previous" : null,
  ].filter(Boolean).join(" ");
const normalizedTrustTier = (tier: string | null | undefined) => (tier ?? "").toLowerCase();
const michelinStarCount = (tier: string | null | undefined) => {
  const normalized = normalizedTrustTier(tier);
  if (normalized.includes("3 star")) {
    return 3;
  }
  if (normalized.includes("2 star")) {
    return 2;
  }
  if (normalized.includes("1 star")) {
    return 1;
  }
  return 0;
};
const michelinTrustSignalModifier = (tier: string | null | undefined) => {
  const normalized = normalizedTrustTier(tier);
  const starCount = michelinStarCount(tier);
  if (starCount > 0) {
    return `place-card-trust-pill--michelin-stars-${starCount}`;
  }
  if (normalized.includes("bib")) {
    return "place-card-trust-pill--michelin-bib";
  }
  if (normalized.includes("green")) {
    return "place-card-trust-pill--michelin-green";
  }
  if (normalized.includes("selected")) {
    return "place-card-trust-pill--michelin-selected";
  }
  return null;
};
const trustSignalIconClassName = (signal: (typeof trustSignals)[number]) =>
  [
    "place-card-trust-icon",
    signal.source === "michelin" && michelinStarCount(signal.tier) > 1 ? "place-card-trust-icon--michelin-stars" : null,
  ].filter(Boolean).join(" ");
const trustSignalIconSvg = (signal: (typeof trustSignals)[number]) => {
  if (signal.source === "michelin") {
    const normalized = normalizedTrustTier(signal.tier);
    const starCount = michelinStarCount(signal.tier);
    if (starCount > 0) {
      return Array.from({ length: starCount }, () => '<img src="/icons/michelin-star.svg" alt="" width="18" height="18" decoding="async" />').join("");
    }
    if (normalized.includes("bib")) {
      return '<img src="/icons/michelin-bib-gourmand.svg" alt="" width="18" height="18" decoding="async" />';
    }
    if (normalized.includes("green")) {
      return '<img src="/icons/michelin-green-star.svg" alt="" width="18" height="18" decoding="async" />';
    }
    return '<img src="/icons/michelin-selected.svg" alt="" width="18" height="18" decoding="async" />';
  }
  if (signal.source === "tabelog") {
    return '<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7 3h10v8.4a5 5 0 0 1-3.5 4.8L12 16.7l-1.5-.5A5 5 0 0 1 7 11.4V3Zm-2 2v4H2V5h3Zm17 0v4h-3V5h3ZM9 5v6.4a3 3 0 0 0 2.1 2.9l.9.3.9-.3a3 3 0 0 0 2.1-2.9V5H9Zm1 14h4v2h-4v-2Z"/></svg>';
  }
  if (signal.source === "timeout") {
    return '<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.8a9.2 9.2 0 1 1 0 18.4 9.2 9.2 0 0 1 0-18.4Zm1 4.2h-2v6.1l4.4 2.6 1-1.7-3.4-2V7Z"/></svg>';
  }
  return '<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false"><path fill="currentColor" d="M5 4h14v16H5V4Zm2 2v12h10V6H7Zm2 2h6v2H9V8Zm0 4h6v2H9v-2Z"/></svg>';
};
const hasTrustSignals = trustSignals.length > 0;
const placeholderMeta =
  place.neighborhood ??
  guideContext.cityName ??
  guideContext.countryName ??
  siteConfig.placeCard.photoPlaceholderFallback;
const hasStats = placeRatingMetaLabel.length > 0;
const hasMetaPills = hasStats || hasTrustSignals;
const metaParts = [
  siteConfig.placeCard.showCategory ? (place.primary_category ?? siteConfig.placeCard.savedPlaceLabel) : null,
  siteConfig.placeCard.showNeighborhood ? place.neighborhood : null,
].filter(Boolean);
const showTopPickBadge = siteConfig.placeCard.showTopPickBadge && (featured || place.top_pick);
const badges = [
  ...(showTopPickBadge ? [{ className: "badge", label: siteConfig.placeCard.topPickLabel }] : []),
  ...(bestHit ? [{ className: "badge badge--best-hit", label: siteConfig.placeCard.bestHitLabel }] : []),
];
const isTemporarilyClosed = siteConfig.placeCard.showStatus && place.status === "temporarily-closed";
const placeAttribution =
  place.added_by && place.added_by.name.trim().length > 0
    ? place.added_by
    : null;
const showPlaceAttribution = Boolean(
  siteConfig.placeCard.showAttribution &&
  placeAttribution &&
  (siteConfig.placeCard.showGuideAuthorAttribution || !authorsReferToSamePerson(placeAttribution, guideAuthor)),
);
const displayedPlaceAttribution = showPlaceAttribution ? placeAttribution : null;
const websiteUrl = safeHttpUrl(place.website);
const reservationLinks = Array.from(new Map((place.reservation_links ?? [])
  .map((link) => ({ label: link.label.trim() || "Find a Table", url: safeHttpUrl(link.url) }))
  .filter((link): link is { label: string; url: string } => link.url !== null)
  .map((link) => [`${link.label.toLowerCase()}:${link.url}`, link])).values());
const reservationLink = reservationLinks.length === 1 ? reservationLinks[0] : null;
const hasReservationOptions = reservationLinks.length > 1;
---

<article
  class="place-card ui-card"
  data-place-card
  data-best-hit={bestHit ? "true" : "false"}
  data-featured={featured ? "true" : "false"}
  data-place-id={place.id}
  data-has-photo={hasPhoto ? "true" : "false"}
  data-name={place.name.toLowerCase()}
  data-tags={filterTagTokens}
  data-vibe-tags={filterVibeTagTokens}
  data-locality-path={localityPathTokens}
  data-category={(place.primary_category ?? "").toLowerCase()}
  data-neighborhood={place.neighborhood ?? ""}
  data-neighborhood-token={neighborhoodToken}
  data-top-pick={place.top_pick ? "true" : "false"}
  data-place-status={place.status}
  data-rating={ratingValue !== null ? String(ratingValue) : ""}
  data-rating-count={reviewCount !== null ? String(reviewCount) : ""}
  data-rank={String(place.manual_rank)}
  data-lat={place.lat !== null ? String(place.lat) : ""}
  data-lng={place.lng !== null ? String(place.lng) : ""}
  data-search={[
    place.name,
    place.address ?? "",
    place.why_recommended ?? "",
    place.note ?? "",
    place.primary_category ?? "",
    place.neighborhood ?? "",
    (place.locality_path ?? []).join(" "),
    place.website ?? "",
    (place.reservation_links ?? []).map((link) => link.label).join(" "),
    placeTags.join(" "),
    placeVibeTags.join(" "),
  ].join(" ").toLowerCase()}
>
  <div class="place-card-photo" aria-hidden={hasPhoto ? undefined : "true"}>
    {hasPhoto ? (
      <img
        src={photoSrc!}
        alt={place.name}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="place-card-photo-placeholder">
        <div class="place-card-photo-placeholder-copy">
          <span class="place-card-photo-placeholder-kicker">
            {place.primary_category ?? siteConfig.placeCard.savedPlaceLabel}
          </span>
          <strong class="place-card-photo-placeholder-title">{placeholderMeta}</strong>
        </div>
        <span class="place-card-photo-placeholder-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12 2.8a6.2 6.2 0 0 1 6.2 6.2c0 4.4-4.8 9.6-5 9.8a1 1 0 0 1-1.4 0c-.2-.2-5-5.4-5-9.8A6.2 6.2 0 0 1 12 2.8Zm0 8.8A2.6 2.6 0 1 0 12 6.4a2.6 2.6 0 0 0 0 5.2Z"
            ></path>
          </svg>
        </span>
      </div>
    )}
  </div>

  <div class="place-card-title">
    <div class="section-stack ui-stack place-card-heading">
      <div class="place-card-name-row">
        <h3 class="ui-card-title" title={place.name}>{place.name}</h3>
        <div class="place-card-title-actions">
          {isTemporarilyClosed && (
            <button
              type="button"
              class="place-card-status-indicator"
              aria-label="Temporarily closed. Check Google Maps before visiting."
              title="Temporarily closed · check before visiting"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M12 3.2a8.8 8.8 0 1 1 0 17.6 8.8 8.8 0 0 1 0-17.6Zm0 2a6.8 6.8 0 1 0 0 13.6 6.8 6.8 0 0 0 0-13.6Zm.9 2.6v4l2.9 1.7-1 1.7-3.9-2.3V7.8h2Z"
                />
              </svg>
              <span class="place-card-status-tooltip" aria-hidden="true">Temporarily closed · check before visiting</span>
            </button>
          )}
          {websiteUrl && (
            <a
              class="place-card-action-link place-card-action-link--website"
              href={websiteUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${place.name} website`}
              title={`Open ${place.name} website`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M12 2.8a9.2 9.2 0 1 1 0 18.4 9.2 9.2 0 0 1 0-18.4Zm0 1.8c-.8.8-1.5 2-1.9 3.5h3.8c-.4-1.5-1.1-2.7-1.9-3.5Zm-3.8 3.5c.3-1.1.8-2.1 1.4-3A7.5 7.5 0 0 0 5.2 8.1h3Zm7.6 0h3a7.5 7.5 0 0 0-4.4-3c.6.9 1.1 1.9 1.4 3Zm-6.1 1.8a14 14 0 0 0 0 4.2h4.6a14 14 0 0 0 0-4.2H9.7Zm-1.8 0H4.6a7.6 7.6 0 0 0 0 4.2h3.3a16.1 16.1 0 0 1 0-4.2Zm8.2 0a16.1 16.1 0 0 1 0 4.2h3.3a7.6 7.6 0 0 0 0-4.2h-3.3Zm-6 6c.4 1.5 1.1 2.7 1.9 3.5.8-.8 1.5-2 1.9-3.5h-3.8Zm-4.9 0a7.5 7.5 0 0 0 4.4 3c-.6-.9-1.1-1.9-1.4-3h-3Zm10.6 0c-.3 1.1-.8 2.1-1.4 3a7.5 7.5 0 0 0 4.4-3h-3Z"
                />
              </svg>
              <span class="visually-hidden">Open website</span>
            </a>
          )}
          {reservationLink && (
            <a
              class="place-card-action-link place-card-action-link--reservation"
              href={reservationLink.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Find a table at ${place.name} via ${reservationLink.label}`}
              title={`Find a Table - ${reservationLink.label}`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M7.4 3.2c.5 0 .9.4.9.9v6.1c0 1.1-.7 2.1-1.8 2.4v6.7a.9.9 0 1 1-1.8 0v-6.7a2.5 2.5 0 0 1-1.8-2.4V4.1a.9.9 0 1 1 1.8 0v5.7h.9V4.1c0-.5.4-.9.9-.9Zm4.6.4a6.8 6.8 0 0 1 6.8 6.8v8.9a.9.9 0 1 1-1.8 0v-4.1h-5a5.8 5.8 0 0 1 0-11.6Zm0 1.8a4 4 0 0 0 0 8h5v-3a5 5 0 0 0-5-5Z"
                />
              </svg>
              <span class="visually-hidden">Find a table</span>
            </a>
          )}
          {hasReservationOptions && (
            <details class="place-card-reservation-menu">
              <summary
                class="place-card-action-link place-card-action-link--reservation"
                aria-label={`Show reservation options for ${place.name}`}
                title="Find a Table"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M7.4 3.2c.5 0 .9.4.9.9v6.1c0 1.1-.7 2.1-1.8 2.4v6.7a.9.9 0 1 1-1.8 0v-6.7a2.5 2.5 0 0 1-1.8-2.4V4.1a.9.9 0 1 1 1.8 0v5.7h.9V4.1c0-.5.4-.9.9-.9Zm4.6.4a6.8 6.8 0 0 1 6.8 6.8v8.9a.9.9 0 1 1-1.8 0v-4.1h-5a5.8 5.8 0 0 1 0-11.6Zm0 1.8a4 4 0 0 0 0 8h5v-3a5 5 0 0 0-5-5Z"
                  />
                </svg>
                <span class="place-card-reservation-caret" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M4.1 5.7 8 9.6l3.9-3.9 1.1 1.1-5 5-5-5 1.1-1.1Z" />
                  </svg>
                </span>
                <span class="visually-hidden">Find a table</span>
              </summary>
              <div class="place-card-reservation-options">
                {reservationLinks.map((link) => (
                  <a
                    class="place-card-reservation-option"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Find a table at ${place.name} via ${link.label}`}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </details>
          )}
          {siteConfig.placeCard.showMapLink && (
            <a
              class="place-card-map-link place-card-action-link place-card-action-link--maps"
              href={place.maps_url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${place.name} in Google Maps`}
              title={`Open ${place.name} in Google Maps`}
            >
              <img
                src="/icons/google-maps.svg"
                alt=""
                width="18"
                height="26"
                loading="lazy"
                decoding="async"
              />
              <span class="place-card-map-link-label" aria-hidden="true">{siteConfig.placeCard.mapsLabel}</span>
            </a>
          )}
        </div>
      </div>
      <div class="place-card-meta-row">
        {metaParts.length > 0 && <p class="meta-copy">{metaParts.join(" · ")}</p>}
        {hasMetaPills && (
          <div class="stats-row ui-meta-row place-card-stats place-card-meta-stats">
            {hasStats && (
              <span class="stat-pill ui-pill place-card-rating-pill" title={placeRatingMetaTitle}>
                {placeRatingMetaLabel}
              </span>
            )}
            {trustSignals.map((signal) =>
              signal.url ? (
                <a
                  class={trustSignalClassName(signal)}
                  href={signal.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={trustSignalTitle(signal)}
                  aria-label={trustSignalTitle(signal)}
                >
                  <span class={trustSignalIconClassName(signal)} set:html={trustSignalIconSvg(signal)} />
                  <span class="visually-hidden">{trustSignalLabel(signal)}</span>
                </a>
              ) : (
                <span
                  class={trustSignalClassName(signal)}
                  title={trustSignalTitle(signal)}
                  role="img"
                  aria-label={trustSignalTitle(signal)}
                >
                  <span class={trustSignalIconClassName(signal)} set:html={trustSignalIconSvg(signal)} />
                  <span class="visually-hidden">{trustSignalLabel(signal)}</span>
                </span>
              )
            )}
          </div>
        )}
      </div>
    </div>
    {badges.length > 0 && (
      <div class="place-card-badges">
        {badges.map((badge) => (
          <span class={badge.className}>{badge.label}</span>
        ))}
      </div>
    )}
  </div>

  {displayedPlaceAttribution && (
    <div class="place-card-attribution">
      <AuthorByline author={displayedPlaceAttribution} label={siteConfig.placeCard.attributionLabel} variant="card" />
    </div>
  )}
  {siteConfig.placeCard.showWhyRecommended && whyRecommendedHtml && (
    <p class="rich-copy ui-copy place-card-description" set:html={whyRecommendedHtml} />
  )}
  {siteConfig.placeCard.showAddress && place.address && (
    <div class="place-card-address" title={place.address}>
      <span class="place-card-address-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 2.8A6.2 6.2 0 0 0 5.8 9c0 4.3 4.9 9.8 5.1 10a1.5 1.5 0 0 0 2.2 0c.2-.2 5.1-5.7 5.1-10A6.2 6.2 0 0 0 12 2.8Zm0 8.5A2.3 2.3 0 1 1 12 6.7a2.3 2.3 0 0 1 0 4.6Z"
          />
        </svg>
      </span>
      <p class="small-copy ui-copy ui-copy--sm place-card-address-copy">
        <span class="place-card-address-label">Address</span>
        <span class="place-card-address-text">{place.address}</span>
      </p>
    </div>
  )}
  {siteConfig.placeCard.showTags && visibleTags.length > 0 && (
    <div class="tag-row ui-tag-row place-card-tags">
      {visibleTags.map((tag) => (
        <span class="tag-pill ui-tag-pill">
          <span class="tag-pill-label">#{tag}</span>
        </span>
      ))}
    </div>
  )}

  {siteConfig.placeCard.showStatus && place.status !== "active" && !isTemporarilyClosed && (
    <div class="place-card-footer ui-card-footer">
      <span class="stat-pill ui-pill">{place.status}</span>
    </div>
  )}
</article>
